PORT=4000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-string
# Origin of the public site (used for the CSRF origin check)
CLIENT_ORIGIN=http://localhost:5173
# Proxy hops in front of the API (Vercel -> Render = 2)
TRUST_PROXY=2
# Used once by `npm run db:setup` to create the first admin
ADMIN_NAME=Premier Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password-now
